<?xml version="1.0"?>
<libraries>
  <library>
    <location>vendor/google/apiclient</location>
    <name>Google API PHP Client</name>
    <description>Client library for Google APIs. Shared HTTP/JWT/log packages are provided by Moodle core (see composer.json replace).</description>
    <version>2.20.1</version>
    <license>Apache-2.0</license>
    <repository>https://github.com/googleapis/google-api-php-client</repository>
  </library>
  <library>
    <location>vendor/google/apiclient-services</location>
    <name>Google API PHP Client Services</name>
    <description>Auto-generated Google API service classes (Calendar subset only).</description>
    <version>0.463.0</version>
    <license>Apache-2.0</license>
    <repository>https://github.com/googleapis/google-api-php-client-services</repository>
  </library>
  <library>
    <location>vendor/google/auth</location>
    <name>Google Auth Library for PHP</name>
    <description>Google Auth Library for PHP.</description>
    <version>1.55.1</version>
    <license>Apache-2.0</license>
    <repository>https://github.com/googleapis/google-auth-library-php</repository>
  </library>
  <library>
    <location>vendor/psr/cache</location>
    <name>PSR-6 Caching Interface</name>
    <description>Common interface for caching libraries (psr/cache), used by google/auth.</description>
    <version>3.0.0</version>
    <license>MIT</license>
    <repository>https://github.com/php-fig/cache</repository>
  </library>
</libraries>
